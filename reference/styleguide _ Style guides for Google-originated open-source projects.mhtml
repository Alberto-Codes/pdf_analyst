],</span>
    <span class=3D"n">require_all_keys</span><span class=3D"p">:</span> <sp=
an class=3D"nb">bool</span> <span class=3D"o">=3D</span> <span class=3D"bp"=
>False</span><span class=3D"p">,</span>
<span class=3D"p">)</span> <span class=3D"o">-&gt;</span> <span class=3D"n"=
>Mapping</span><span class=3D"p">[</span><span class=3D"nb">bytes</span><sp=
an class=3D"p">,</span> <span class=3D"nb">tuple</span><span class=3D"p">[<=
/span><span class=3D"nb">str</span><span class=3D"p">,</span> <span class=
