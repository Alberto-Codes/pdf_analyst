pan class=3D"p">}</span>
     <span class=3D"n">x</span> <span class=3D"o">=3D</span> <span class=3D=
"s">'name: {}; score: {}'</span><span class=3D"p">.</span><span class=3D"nb=
">format</span><span class=3D"p">(</span><span class=3D"n">name</span><span=
