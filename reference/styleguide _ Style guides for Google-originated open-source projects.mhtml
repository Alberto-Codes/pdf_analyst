n><span class=3D"n">MyLongType2</span><span class=3D"p">]],</span>
    <span class=3D"n">second_var</span><span class=3D"p">:</span> <span cla=
ss=3D"nb">list</span><span class=3D"p">[</span><span class=3D"nb">dict</spa=
n><span class=3D"p">[</span>
