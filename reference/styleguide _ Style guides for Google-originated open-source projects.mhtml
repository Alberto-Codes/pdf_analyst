quence</span><span class=3D"p">[</span><span class=3D"n">MyClass</span><spa=
n class=3D"p">],</span> <span class=3D"n">item</span><span class=3D"p">:</s=
pan> <span class=3D"n">OtherClass</span><span class=3D"p">)</span> <span cl=
