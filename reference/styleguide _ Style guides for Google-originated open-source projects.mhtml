s=3D"n">append</span><span class=3D"p">(</span><span class=3D"s">'&lt;tr&gt=
;&lt;td&gt;%s, %s&lt;/td&gt;&lt;/tr&gt;'</span> <span class=3D"o">%</span> =
<span class=3D"p">(</span><span class=3D"n">last_name</span><span class=3D"=
p">,</span> <span class=3D"n">first_name</span><span class=3D"p">))</span>
