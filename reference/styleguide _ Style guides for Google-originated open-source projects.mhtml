mmon way to use them.</p>

<p>Example:</p>

<div class=3D"language-python highlighter-rouge"><div class=3D"highlight"><=
pre class=3D"highlight"><code><span class=3D"kn">from</span> <span class=3D=
"nn">collections.abc</span> <span class=3D"kn">import</span> <span class=3D=
"n">Callable</span>
<span class=3D"kn">from</span> <span class=3D"nn">typing</span> <span class=
=3D"kn">import</span> <span class=3D"n">ParamSpec</span><span class=3D"p">,=
</span> <span class=3D"n">TypeVar</span>
<span class=3D"n">_P</span> <span class=3D"o">=3D</span> <span class=3D"n">=
ParamSpec</span><span class=3D"p">(</span><span class=3D"s">"_P"</span><spa=
n class=3D"p">)</span>
<span class=3D"n">_T</span> <span class=3D"o">=3D</span> <span class=3D"n">=
TypeVar</span><span class=3D"p">(</span><span class=3D"s">"_T"</span><span =
class=3D"p">)</span>
<span class=3D"p">...</span>
<span class=3D"k">def</span> <span class=3D"nf">next</span><span class=3D"p=
">(</span><span class=3D"n">l</span><span class=3D"p">:</span> <span class=
=3D"nb">list</span><span class=3D"p">[</span><span class=3D"n">_T</span><sp=
an class=3D"p">])</span> <span class=3D"o">-&gt;</span> <span class=3D"n">_=
T</span><span class=3D"p">:</span>
  <span class=3D"k">return</span> <span class=3D"n">l</span><span class=3D"=
p">.</span><span class=3D"n">pop</span><span class=3D"p">()</span>

<span class=3D"k">def</span> <span class=3D"nf">print_when_called</span><sp=
an class=3D"p">(</span><span class=3D"n">f</span><span class=3D"p">:</span>=
