<span class=3D"n">LongTypeName</span><span class=3D"p">,</span>
<span class=3D"p">)</span> <span class=3D"o">-&gt;</span> <span class=3D"bp=
">None</span><span class=3D"p">:</span>
  <span class=3D"p">...</span>
</code></pre></div></div>

<div class=3D"language-python highlighter-rouge"><div class=3D"highlight"><=
pre class=3D"highlight"><code><span class=3D"n">No</span><span class=3D"p">=
:</span>
<span class=3D"k">def</span> <span class=3D"nf">my_function</span><span cla=
ss=3D"p">(</span>
    <span class=3D"n">long_variable_name</span><span class=3D"p">:</span> <=
