<ul>
  <li>not externally visible</li>
  <li>not constrained</li>
</ul>

<div class=3D"language-python highlighter-rouge"><div class=3D"highlight"><=
pre class=3D"highlight"><code><span class=3D"n">Yes</span><span class=3D"p"=
>:</span>
  <span class=3D"n">_T</span> <span class=3D"o">=3D</span> <span class=3D"n=
">TypeVar</span><span class=3D"p">(</span><span class=3D"s">"_T"</span><spa=
n class=3D"p">)</span>
  <span class=3D"n">_P</span> <span class=3D"o">=3D</span> <span class=3D"n=
">ParamSpec</span><span class=3D"p">(</span><span class=3D"s">"_P"</span><s=
pan class=3D"p">)</span>
  <span class=3D"n">AddableType</span> <span class=3D"o">=3D</span> <span c=
lass=3D"n">TypeVar</span><span class=3D"p">(</span><span class=3D"s">"Addab=
leType"</span><span class=3D"p">,</span> <span class=3D"nb">int</span><span=
