n">_P</span><span class=3D"p">,</span> <span class=3D"n">_T</span><span cla=
ss=3D"p">])</span> <span class=3D"o">-&gt;</span> <span class=3D"n">Callabl=
e</span><span class=3D"p">[</span><span class=3D"n">_P</span><span class=3D=
"p">,</span> <span class=3D"n">_T</span><span class=3D"p">]:</span>
  <span class=3D"k">def</span> <span class=3D"nf">inner</span><span class=
=3D"p">(</span><span class=3D"o">*</span><span class=3D"n">args</span><span=
 class=3D"p">:</span> <span class=3D"n">_P</span><span class=3D"p">.</span>=
<span class=3D"n">args</span><span class=3D"p">,</span> <span class=3D"o">*=
*</span><span class=3D"n">kwargs</span><span class=3D"p">:</span> <span cla=
ss=3D"n">_P</span><span class=3D"p">.</span><span class=3D"n">kwargs</span>=
<span class=3D"p">)</span> <span class=3D"o">-&gt;</span> <span class=3D"n"=
>_T</span><span class=3D"p">:</span>
    <span class=3D"k">print</span><span class=3D"p">(</span><span class=3D"=
s">"Function was called"</span><span class=3D"p">)</span>
    <span class=3D"k">return</span> <span class=3D"n">f</span><span class=
=3D"p">(</span><span class=3D"o">*</span><span class=3D"n">args</span><span=
 class=3D"p">,</span> <span class=3D"o">**</span><span class=3D"n">kwargs</=
span><span class=3D"p">)</span>
  <span class=3D"k">return</span> <span class=3D"n">inner</span>
</code></pre></div></div>

<p>A <code class=3D"language-plaintext highlighter-rouge">TypeVar</code> ca=
n be constrained:</p>

<div class=3D"language-python highlighter-rouge"><div class=3D"highlight"><=
pre class=3D"highlight"><code><span class=3D"n">AddableType</span> <span cl=
ass=3D"o">=3D</span> <span class=3D"n">TypeVar</span><span class=3D"p">(</s=
pan><span class=3D"s">"AddableType"</span><span class=3D"p">,</span> <span =
class=3D"nb">int</span><span class=3D"p">,</span> <span class=3D"nb">float<=
/span><span class=3D"p">,</span> <span class=3D"nb">str</span><span class=
=3D"p">)</span>
<span class=3D"k">def</span> <span class=3D"nf">add</span><span class=3D"p"=
>(</span><span class=3D"n">a</span><span class=3D"p">:</span> <span class=
