    <span class=3D"n">first_var</span><span class=3D"p">:</span> <span clas=
s=3D"nb">tuple</span><span class=3D"p">[</span><span class=3D"nb">list</spa=
n><span class=3D"p">[</span><span class=3D"n">MyLongType1</span><span class=
=3D"p">],</span>
